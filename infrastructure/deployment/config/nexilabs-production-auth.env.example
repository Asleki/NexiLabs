# P006.UI.10.4 — TEMPLATE ONLY. Never commit real passwords or Enigma material.
# Install as /etc/nexa/nexilabs-production-auth.env, owner root:nexa-auth, mode 0640.

PGHOST=__SET_ON_SERVER_ONLY__
PGPORT=5432
PGDATABASE=npp_dev
PGUSER=__SET_ON_SERVER_ONLY__
PGPASSWORD=__SET_ON_SERVER_ONLY__
PGSSLMODE=require

# This directory is outside Git and must contain the byte-preserved private Enigma catalogues.
NEXILABS_PRIVATE_ENIGMA_DIR=/etc/nexa/nexilabs-auth-private/enigma

# Exact browser Origins only. Wildcards are rejected by the transport.
NEXILABS_PRODUCTION_AUTH_ALLOWED_ORIGINS=https://nexilabs.nexaecosystem.com
