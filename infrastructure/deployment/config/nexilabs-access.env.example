# NEXILABS.PAB.1
# Copy to /etc/nexa/nexilabs-access.env and chmod 0640 root:nexa-access.
#
# This file is a template only. Do not commit real OAuth or cookie secrets.

NEXILABS_ACCESS_MODE=DEVELOPMENT_PRIVATE
NEXILABS_PUBLIC_HOSTNAME=nexilabs.nexaecosystem.com

# Loopback or private upstream that serves the NexiLabs PWA.
# The final hosting service is qualified separately.
NEXILABS_PWA_UPSTREAM=127.0.0.1:8765

# oauth2-proxy Google provider configuration.
OAUTH2_PROXY_PROVIDER=google
OAUTH2_PROXY_HTTP_ADDRESS=127.0.0.1:4180
OAUTH2_PROXY_REVERSE_PROXY=true
OAUTH2_PROXY_REDIRECT_URL=https://nexilabs.nexaecosystem.com/oauth2/callback
OAUTH2_PROXY_AUTHENTICATED_EMAILS_FILE=/etc/nexa/nexilabs-access/allowed-emails
OAUTH2_PROXY_CLIENT_ID=__SET_ON_SERVER_ONLY__
OAUTH2_PROXY_CLIENT_SECRET=__SET_ON_SERVER_ONLY__
OAUTH2_PROXY_COOKIE_SECRET=__SET_ON_SERVER_ONLY__
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_COOKIE_HTTPONLY=true
OAUTH2_PROXY_COOKIE_SAMESITE=lax
OAUTH2_PROXY_COOKIE_REFRESH=1h
OAUTH2_PROXY_COOKIE_EXPIRE=8h
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true
OAUTH2_PROXY_UPSTREAM=static://202
