  "predecessorMilestone": "NEXILABS.PAB.1",
  "maintenanceClassification": "SECURITY_COMPATIBILITY_MAINTENANCE_EXCEPTION",
  "offlineCapability": {
    "applicationShellAllowed": true,
    "simulationAllowed": true,
    "approvedStaticAssetsAllowed": true,
    "genericLiveAuthorityCachingAllowed": false
  },
  "liveAuthority": {
